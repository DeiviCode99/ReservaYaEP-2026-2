# =====================================================================
# ReservaYa - Variables de entorno del backend
# Copia este archivo como ".env" y rellena los valores reales.
# El ".env" esta en .gitignore: NUNCA lo subas al repositorio.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (PostgreSQL)
# Donde sacarlos: Supabase -> Project Settings -> Database -> Connection string
#   * Elige la pestana "JDBC" y el modo "Session pooler" (puerto 5432).
#   * El "Transaction pooler" (puerto 6543) tambien sirve, pero entonces
#     hay que anadir &prepareThreshold=0 a la URL porque PgBouncer en modo
#     transaccion no soporta prepared statements.
# ---------------------------------------------------------------------
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.tu-project-ref
SUPABASE_DB_PASSWORD=tu-password-de-la-base-de-datos

# Conexiones por servicio. Hay 3 servicios conectados a la misma BD,
# asi que conviene mantener el pool pequeno en el plan gratuito.
DB_POOL_SIZE=5

# ---------------------------------------------------------------------
# JWT (RNF-04)
# Debe ser EL MISMO valor en auth-service, restaurant-service y
# reservation-service: uno firma y los otros dos verifican.
# Donde sacarlo: Supabase -> Project Settings -> JWT Keys -> JWT Secret (Current)
# o generarlo con:  openssl rand -base64 48
# MINIMO 32 caracteres: con menos los servicios no arrancan (WeakKeyException).
# ---------------------------------------------------------------------
JWT_SECRET=tu-jwt-secret-de-supabase
JWT_ISSUER=reservaya-auth
JWT_EXPIRATION_MINUTES=120

# ---------------------------------------------------------------------
# Puertos y URLs entre servicios (valores por defecto, se pueden omitir)
# ---------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
RESTAURANT_SERVICE_PORT=8082
RESERVATION_SERVICE_PORT=8083

AUTH_SERVICE_URI=http://localhost:8081
RESTAURANT_SERVICE_URI=http://localhost:8082
RESERVATION_SERVICE_URI=http://localhost:8083

# Origen del frontend para CORS (el server.js de Node corre en el 3000)
FRONTEND_ORIGIN=http://localhost:3000

# Reglas de negocio
MIN_HOURS_BEFORE_CANCEL=2

# ---------------------------------------------------------------------
# Inicio de sesion con Google (RF-15). Vacio = el boton no aparece.
# Donde sacarlo: console.cloud.google.com -> APIs y servicios ->
# Credenciales -> Crear ID de cliente de OAuth -> "Aplicacion web".
# En "Origenes de JavaScript autorizados" agrega http://localhost:3000
# y https://<DOMAIN>. No hace falta secreto de cliente.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=790565303427-8muerppei3mi5gaedog3lfdkpf2mdrua.apps.googleusercontent.com

# ---------------------------------------------------------------------
# Recuperacion de cuenta por correo (RF-16)
# El enlace del correo apunta a FRONTEND_ORIGIN/recuperar.html.
# Sin SPRING_MAIL_HOST el enlace se escribe en el log de auth-service
# (sirve para probar en local). Con Gmail: activa la verificacion en 2
# pasos y crea una "contrasena de aplicacion" para SPRING_MAIL_PASSWORD.
# ---------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=ReservaYa <tu-correo@gmail.com>
RESET_EXPIRATION_MINUTES=30

# Depuracion
JPA_SHOW_SQL=false

# ---------------------------------------------------------------------
# Produccion (docker-compose.yml): dominio publico que atiende Caddy.
# Ej: reservaya.duckdns.org. En produccion FRONTEND_ORIGIN=https://<DOMAIN>
# ---------------------------------------------------------------------
DOMAIN=reservaya.duckdns.org
