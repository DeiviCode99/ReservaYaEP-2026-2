# Caddy obtiene el certificado HTTPS de Let's Encrypt solo con el dominio.
{$DOMAIN} {
	handle /api/* {
		reverse_proxy api-gateway:8080
	}
	handle {
		root * /srv
		# Redireccion (no rewrite): las paginas se enlazan con rutas relativas
		# ("login.html"), que solo funcionan si la URL real esta bajo /html/.
		redir / /html/index.html
		file_server
	}
}
