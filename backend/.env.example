# =====================================================================
# ReservaYa - Variables de entorno del backend (Django)
# Copia este archivo como ".env" y rellena los valores reales.
# El ".env" esta en .gitignore: NUNCA lo subas al repositorio.
# Los servicios lo leen solos al arrancar (no hace falta exportarlo).
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (PostgreSQL)
# Supabase -> Project Settings -> Database -> Connection string, modo
# "Session pooler" (puerto 5432). Se acepta el formato postgresql://...
# y tambien el formato JDBC del backend anterior (jdbc:postgresql://...).
# Con el "Transaction pooler" (puerto 6543) tambien funciona.
# ---------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.tu-project-ref
SUPABASE_DB_PASSWORD=tu-password-de-la-base-de-datos

# ---------------------------------------------------------------------
# JWT (RNF-04). El MISMO valor en los tres servicios: auth firma y los
# otros verifican. MINIMO 32 caracteres. Generarlo: openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_SECRET=tu-jwt-secret-de-al-menos-32-caracteres
JWT_ISSUER=reservaya-auth
JWT_EXPIRATION_MINUTES=120

# Django: en desarrollo puedes poner DJANGO_DEBUG=true.
DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=   (opcional; si falta se usa JWT_SECRET)

# ---------------------------------------------------------------------
# URLs entre servicios (desarrollo local). En Docker las define
# docker-compose.yml con los nombres de los contenedores.
# ---------------------------------------------------------------------
AUTH_SERVICE_URI=http://localhost:8081
RESTAURANT_SERVICE_URI=http://localhost:8082
RESERVATION_SERVICE_URI=http://localhost:8083

# Origen del frontend: CORS del gateway y enlace del correo de recuperacion.
# En produccion: FRONTEND_ORIGIN=https://<DOMAIN>
FRONTEND_ORIGIN=http://localhost:3000

# Reglas de negocio
MIN_HOURS_BEFORE_CANCEL=2

# ---------------------------------------------------------------------
# Inicio de sesion con Google (RF-15). Vacio = el boton no aparece.
# console.cloud.google.com -> Credenciales -> ID de cliente OAuth "Aplicacion web",
# origenes autorizados: http://localhost:3000 y https://<DOMAIN>.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------
# Correo: recuperacion de cuenta (RF-16) y notificaciones de reservas.
# Sin EMAIL_HOST el enlace y las notificaciones se escriben en el log.
# Con Gmail: verificacion en 2 pasos + "contrasena de aplicacion".
# (Los nombres SPRING_MAIL_* del backend anterior tambien se aceptan.)
# ---------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
MAIL_FROM="ReservaYa <tu-correo@gmail.com>"
RESET_EXPIRATION_MINUTES=30

# ---------------------------------------------------------------------
# Produccion (docker-compose.yml): dominio publico que atiende Caddy.
# ---------------------------------------------------------------------
DOMAIN=reservaya.duckdns.org
